---
import Layout from '../layouts/Layout.astro';

const featuredProjects = [
  {
    name: 'Qodi',
    eyebrow: 'Secure platform service',
    description: 'Encrypted, time-limited QR workflows with public-key encryption, server-side decryption, expiration enforcement, and an OpenAPI contract.',
    tags: ['TypeScript', 'Cryptography', 'OpenAPI', 'Docker'],
    github: 'https://github.com/GiganticPlayground/qodi',
    accent: 'indigo',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />`
  },
  {
    name: 'Examen',
    eyebrow: 'Release validation',
    description: 'Declarative HTTP and CLI testing with YAML suites, assertions, retries, chained execution, parallel checks, and lifecycle hooks.',
    tags: ['TypeScript', 'Testing', 'CLI', 'YAML'],
    github: 'https://github.com/GiganticPlayground/examen',
    accent: 'purple',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    name: 'Token Weaver',
    eyebrow: 'Authentication infrastructure',
    description: 'A stateless, strategy-driven gateway that translates direct credentials or upstream authentication responses into signed JWTs.',
    tags: ['TypeScript', 'JWT', 'Authentication', 'Security'],
    github: 'https://github.com/GiganticPlayground/token-weaver',
    accent: 'blue',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H3v-4l6.257-6.257A6 6 0 1121 9z" />`
  },
  {
    name: 'Airlock Registry',
    eyebrow: 'Isolated deployment',
    description: 'A container distribution template that separates publishing and retrieval through object storage for network-isolated environments.',
    tags: ['Containers', 'S3', 'Shell', 'Infrastructure'],
    github: 'https://github.com/GiganticPlayground/airlock-registry',
    accent: 'emerald',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7m-8 0c0 2.21 3.582 4 8 4s8-1.79 8-4m-8 0c0-2.21 3.582-4 8-4s8 1.79 8 4" />`
  }
];

const projectGroups = [
  {
    title: 'Additional Projects',
    projects: [
      { name: 'Reqcast', description: 'Configurable Express request analytics with sensitive-field redaction and log, file, or AMQP outputs.', tags: ['TypeScript', 'Observability'], github: 'https://github.com/GiganticPlayground/reqcast' },
      { name: 'Escapement', description: 'Serialized, durable state transitions over S3 for finite code pools, quotas, and reservations.', tags: ['S3', 'State Machines'], github: 'https://github.com/GiganticPlayground/Escapement' },
      { name: 'EnvarynAI', description: 'Speech capture and transcription with a Flutter client, queued workers, and PostgreSQL transcript storage.', tags: ['Flutter', 'TypeScript'], github: 'https://github.com/daniellmorris/EnvarynAI' },
      { name: 'Local Claude Chat History MCP', description: 'A local MCP server for searching Claude Code and Cowork transcripts without uploading conversation data.', tags: ['MCP', 'Developer Tools'], github: 'https://github.com/daniellmorris/local-claude-chat-history-mcp' },
      { name: 'SpecHero', description: 'Specification-first service starter with OpenAPI and AsyncAPI routing, schema validation, and AMQP bindings.', tags: ['OpenAPI', 'AsyncAPI'], github: 'https://github.com/daniellmorris/spechero' }
    ]
  },
  {
    title: 'Created',
    projects: [
      { name: 'Logra', description: 'Async context-aware structured logging for Node.js.', tags: ['Node.js', 'Observability'], github: 'https://github.com/GiganticPlayground/logra' },
      { name: 'Kusto Docker Log Aggregator', description: 'Docker log forwarding for local Kusto exploration.', tags: ['Docker', 'Kusto'], github: 'https://github.com/daniellmorris/kusto-docker-log-aggregator' },
      { name: 'Shillkill', description: 'Browser filtering for cryptocurrency spam patterns.', tags: ['JavaScript', 'Chrome'], github: 'https://github.com/daniellmorris/shillkill' }
    ]
  },
  {
    title: 'Created & Maintained',
    projects: [
      { name: 'Rule Harvester', description: 'Declarative JavaScript rules evaluation and data transformation.', tags: ['Node.js', 'Rules'], github: 'https://github.com/GiganticPlayground/rule-harvester' },
      { name: 'AMQP Cacoon', description: 'Reliable AMQP connection management, retries, and flow control.', tags: ['Node.js', 'AMQP'], github: 'https://github.com/GiganticPlayground/amqp-cacoon' }
    ]
  },
  {
    title: 'Contributed',
    projects: [
      { name: 'PayloadStash', description: 'YAML-driven HTTP sequences, validation, capture, and reporting.', tags: ['Python', 'Testing'], github: 'https://github.com/ericwastaken/PayloadStash' }
    ]
  }
];

const caseStudies = [
  {
    name: 'Fan Engagement Platforms',
    context: 'Themed Entertainment & Media',
    challenge: 'Support interactive experiences, progression, rewards, and real-time engagement across distributed systems.',
    approach: 'Led backend architecture, event-driven service design, caching, partner integration, and production delivery.',
    outcome: 'Created a repeatable platform foundation that moved from prototype through launch and ongoing operations.',
    technologies: ['Node.js', 'MongoDB', 'Redis', 'RabbitMQ', 'AWS', 'Docker'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.956a1 1 0 00.95.69h4.16c.969 0 1.371 1.24.588 1.81l-3.366 2.445a1 1 0 00-.364 1.118l1.286 3.956c.3.921-.755 1.688-1.539 1.118l-3.365-2.445a1 1 0 00-1.176 0L8.046 18.02c-.783.57-1.838-.197-1.539-1.118l1.286-3.956a1 1 0 00-.364-1.118L4.064 9.383c-.783-.57-.38-1.81.588-1.81h4.16a1 1 0 00.95-.69l1.287-3.956z" />`
  },
  {
    name: 'Hybrid Platform Deployments',
    context: 'Enterprise Infrastructure',
    challenge: 'Deliver event-driven services consistently across cloud, on-premises, and network-isolated environments.',
    approach: 'Designed infrastructure automation, container distribution, managed secrets, and environment-specific deployment workflows.',
    outcome: 'Improved deployment repeatability, security posture, and operational readiness across environments.',
    technologies: ['AWS', 'Terraform', 'Docker', 'S3', 'KMS', 'RabbitMQ'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`
  },
  {
    name: 'High-Scale Event Systems',
    context: 'Interactive Experiences',
    challenge: 'Maintain predictable behavior during traffic spikes, time-sensitive events, and partial system failures.',
    approach: 'Applied caching, batching, queue management, horizontal scaling, load testing, and recovery design.',
    outcome: 'Validated performance characteristics and strengthened resilience under high-concurrency workloads.',
    technologies: ['Node.js', 'Kubernetes', 'RabbitMQ', 'Redis', 'MongoDB'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    name: 'Applied AI & Developer Enablement',
    context: 'Research & Prototyping',
    challenge: 'Turn rapidly changing AI capabilities into useful software patterns and dependable engineering workflows.',
    approach: 'Explored speech processing, structured extraction, LLM integrations, and repeatable AI-assisted development practices.',
    outcome: 'Produced practical prototypes and workflow improvements while keeping architecture and operational concerns explicit.',
    technologies: ['LLM APIs', 'Speech Processing', 'TypeScript', 'Python', 'PostgreSQL'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.373 3.373 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`
  }
];
---

<Layout title="Projects - Dan Morris">
  <div class="max-w-6xl mx-auto">
    <header class="max-w-3xl mb-10 sm:mb-14 reveal">
      <span class="section-kicker">Selected Work</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold mt-3 mb-4 gradient-text">Projects & Architecture</h1>
      <p class="text-gray-300 text-lg leading-relaxed">
        Public developer tools and NDA-safe case studies focused on secure platforms, reliable delivery, and operational clarity.
      </p>
    </header>

    <section class="mb-14 sm:mb-20 reveal" style="--delay: 70ms">
      <div class="flex items-end justify-between gap-4 mb-6">
        <div>
          <span class="section-kicker">Featured Open Source</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3">Tools built from real platform needs</h2>
        </div>
        <a href="https://github.com/daniellmorris" target="_blank" rel="noopener noreferrer" class="hidden sm:inline text-sm font-semibold text-indigo-300 hover:text-indigo-200">GitHub profile</a>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {featuredProjects.map((project, i) => (
          <article class={`featured-project featured-${project.accent} rounded-2xl p-5 sm:p-7 reveal`} style={`--delay: ${100 + i * 55}ms`}>
            <div class="flex items-start justify-between gap-4 mb-5 sm:mb-8">
              <div class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-indigo-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={project.icon} />
              </div>
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-300 hover:text-white transition-colors">
                View source
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5m0 0v5m0-5L10 14M5 7v12h12" />
                </svg>
              </a>
            </div>
            <p class="text-xs uppercase tracking-[0.14em] font-bold text-indigo-300 mb-2">{project.eyebrow}</p>
            <h3 class="text-2xl font-bold text-white mb-3">{project.name}</h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4 sm:mb-6">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-14 sm:mb-20 reveal" style="--delay: 170ms">
      <div class="mb-6">
        <span class="section-kicker">More Open Source</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3">Created, maintained, and improved</h2>
      </div>
      <div class="surface rounded-2xl divide-y divide-white/10">
        {projectGroups.map(group => (
          <div class="grid md:grid-cols-[180px_1fr] gap-4 px-5 py-6 sm:px-7">
            <h3 class="text-sm font-bold text-indigo-300 uppercase tracking-wider">{group.title}</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {group.projects.map(project => (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="group rounded-xl p-4 bg-white/[0.025] hover:bg-white/[0.055] border border-white/[0.06] hover:border-indigo-400/25 transition-all">
                  <div class="flex items-center justify-between gap-3">
                    <h4 class="font-semibold text-white group-hover:text-indigo-200 transition-colors">{project.name}</h4>
                    <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-indigo-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5m0 0v5m0-5L10 14M5 7v12h12" />
                    </svg>
                  </div>
                  <p class="hidden sm:block text-gray-400 text-xs leading-relaxed mt-2 mb-3">{project.description}</p>
                  <div class="flex gap-2 text-[11px] text-gray-400">
                    {project.tags.map(tag => <span>{tag}</span>)}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal" style="--delay: 240ms">
      <div class="max-w-3xl mb-7">
        <span class="section-kicker">Architecture Case Studies</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3 mb-3">Complex work, described without confidential details</h2>
        <p class="text-gray-400 leading-relaxed">Each summary focuses on the engineering problem, architectural approach, and durable outcome.</p>
      </div>

      <div class="space-y-4">
        {caseStudies.map((project, i) => (
          <article class="case-study surface rounded-2xl p-4 sm:p-7">
            <div class="grid lg:grid-cols-[230px_1fr] gap-4 sm:gap-6 lg:gap-10">
              <div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-400/20 flex items-center justify-center mb-4">
                  <svg class="w-5 h-5 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={project.icon} />
                </div>
                <p class="text-xs uppercase tracking-[0.12em] font-bold text-purple-300 mb-2">{project.context}</p>
                <h3 class="text-xl font-bold text-white">{project.name}</h3>
              </div>
              <div class="grid md:grid-cols-3 gap-3 sm:gap-5">
                <div>
                  <p class="case-label">Challenge</p>
                  <p class="case-copy">{project.challenge}</p>
                </div>
                <div>
                  <p class="case-label">Approach</p>
                  <p class="case-copy">{project.approach}</p>
                </div>
                <div>
                  <p class="case-label">Outcome</p>
                  <p class="case-copy">{project.outcome}</p>
                </div>
              </div>
            </div>
            <div class="hidden sm:flex flex-wrap gap-2 mt-6 pt-5 border-t border-white/10 lg:ml-[270px]">
              {project.technologies.map(tech => <span class="tag tag-purple">{tech}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .featured-project {
    min-height: 330px;
    border: 1px solid rgba(148, 163, 184, 0.15);
    background:
      radial-gradient(circle at 100% 0%, var(--accent-glow), transparent 48%),
      rgba(10, 15, 28, 0.82);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .featured-project:hover {
    transform: translateY(-3px);
    border-color: var(--accent-border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .featured-indigo { --accent-glow: rgba(99, 102, 241, 0.2); --accent-border: rgba(129, 140, 248, 0.42); }
  .featured-purple { --accent-glow: rgba(168, 85, 247, 0.18); --accent-border: rgba(192, 132, 252, 0.42); }
  .featured-blue { --accent-glow: rgba(59, 130, 246, 0.18); --accent-border: rgba(96, 165, 250, 0.42); }
  .featured-emerald { --accent-glow: rgba(16, 185, 129, 0.16); --accent-border: rgba(52, 211, 153, 0.38); }

  .case-study {
    transition: border-color 0.2s ease;
  }

  .case-study:hover {
    border-color: rgba(168, 85, 247, 0.28);
  }

  .case-label {
    margin-bottom: 0.45rem;
    color: #c4b5fd;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-copy {
    color: #d1d5db;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .featured-project { min-height: 0; }
  }
</style>
