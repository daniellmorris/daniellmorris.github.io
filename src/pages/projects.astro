---
import Layout from '../layouts/Layout.astro';

const openSourceProjects = [
  {
    name: 'Rule Harvester',
    description: 'A general-purpose rules engine that processes rule definitions against input, transforming data through defined rules. Used in production theme park systems.',
    role: 'Original Author + Maintainer',
    tags: ['Node.js', 'Rules Engine', 'Data Processing'],
    github: 'https://github.com/valtech-sd/rule-harvester'
  },
  {
    name: 'AMQP Cacoon',
    description: 'An abstraction around node-amqp-connection-manager providing a simple interface with flow control, retries, and automatic reconnects.',
    role: 'Original Author + Maintainer',
    tags: ['Node.js', 'AMQP', 'Message Queue'],
    github: 'https://github.com/valtech-sd/amqp-cacoon'
  },
  {
    name: 'Shillkill',
    description: 'Chrome extension for Twitter/X to block shills and spam accounts, improving the user experience for crypto and tech communities.',
    role: 'Original Author',
    tags: ['JavaScript', 'Chrome Extension', 'Social Media'],
    github: '#'
  }
];

const clientProjects = [
  {
    name: 'Theme Park Rewards Engine',
    client: 'Universal Studios',
    description: 'Highly configurable rewards engine enabling quest-based player engagement and real-time rewards distribution across multiple theme parks.',
    technologies: ['Node.js', 'MongoDB', 'Redis', 'RabbitMQ', 'AWS'],
    impact: 'Deployed across multiple parks, processing millions of guest interactions daily.',
    icon: '🏆'
  },
  {
    name: 'Analytics Platform',
    client: 'Theme Park Client',
    description: 'Comprehensive analytics pipeline tracking and analyzing theme park activities and guest behavior patterns in real time.',
    technologies: ['Python', 'AWS', 'ElasticSearch', 'Kibana'],
    impact: 'Processed millions of daily events, providing actionable insights for business decisions.',
    icon: '📊'
  },
  {
    name: 'Scalable Microservice Platform',
    client: 'Enterprise',
    description: 'Event streaming platform handling high-concurrency workloads during peak events, built on Kubernetes and RabbitMQ.',
    technologies: ['Node.js', 'Kubernetes', 'RabbitMQ', 'Redis', 'Docker'],
    impact: 'Successfully handled 50k+ active concurrent users during time-sensitive events.',
    icon: '🚀'
  },
  {
    name: 'OTT Media Pipeline',
    client: 'Dolby',
    description: 'Media processing platform for streaming content with Dolby Technology integration, supporting high-quality audio/visual output.',
    technologies: ['Node.js', 'FFmpeg', 'AWS', 'Docker', 'Lambda'],
    impact: 'Streamlined media processing workflow, reducing delivery time for high-quality content.',
    icon: '🎬'
  }
];
---

<Layout title="Projects - Dan Morris">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold mb-3 gradient-text">Projects Portfolio</h1>
      <p class="text-gray-400 text-lg">Open source contributions and client work across industries.</p>
    </div>

    <!-- Open Source -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-indigo-500/15 border border-indigo-500/25 flex items-center justify-center">
          <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Open Source</h2>
      </div>
      <div class="grid gap-5">
        {openSourceProjects.map(project => (
          <div class="bg-white/3 border border-white/8 rounded-xl p-6 card-glow transition-all duration-200">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-lg font-semibold gradient-text-blue">{project.name}</h3>
              {project.github !== '#' && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-indigo-400 transition-colors px-3 py-1.5 rounded-lg border border-white/8 hover:border-indigo-500/30 bg-white/3"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                  GitHub ↗
                </a>
              )}
            </div>
            <p class="text-gray-400 text-sm leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs text-gray-500 font-medium">{project.role}</span>
              <span class="text-gray-700">·</span>
              {project.tags.map(tag => (
                <span class="tag text-xs">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Client Projects -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-purple-500/15 border border-purple-500/25 flex items-center justify-center">
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Client Projects</h2>
      </div>
      <div class="grid gap-5">
        {clientProjects.map(project => (
          <div class="bg-white/3 border border-white/8 rounded-xl p-6 card-glow transition-all duration-200">
            <div class="flex items-start gap-4">
              <span class="text-3xl flex-shrink-0">{project.icon}</span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <h3 class="text-lg font-semibold text-white">{project.name}</h3>
                  <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300">{project.client}</span>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed mb-4">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {project.technologies.map(tech => (
                    <span class="tag tag-purple text-xs">{tech}</span>
                  ))}
                </div>
                <div class="flex items-start gap-2 text-sm">
                  <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                  <span class="text-gray-400">{project.impact}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
