---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dan Morris - Software Engineer & Architect">
  <div class="min-h-screen">

    <!-- Hero -->
    <div class="relative overflow-hidden rounded-2xl mb-16 hero-section">
      <div class="relative z-10 py-24 px-8 md:px-16 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 text-sm font-medium mb-8">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Available for new opportunities
        </div>
        <h1 class="text-6xl md:text-7xl font-extrabold mb-4 tracking-tight">
          <span class="text-white">Dan</span>
          <span class="gradient-text"> Morris</span>
        </h1>
        <p class="text-2xl md:text-3xl text-gray-300 font-light mb-3">Software Engineer & Architect</p>
        <p class="text-gray-500 max-w-xl mx-auto mb-10 text-lg">
          Building scalable backend systems and beautiful products — 15+ years turning complex challenges into elegant solutions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/about" class="px-8 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5">
            View My Work
          </a>
          <a href="mailto:dan@daniellmorris.com" class="px-8 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white font-semibold transition-all duration-200 hover:-translate-y-0.5">
            Get in Touch
          </a>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      {[
        { value: '15+', label: 'Years Experience' },
        { value: '6', label: 'Industries' },
        { value: '2', label: 'Patents Held' },
        { value: '∞', label: 'Problems Solved' }
      ].map(stat => (
        <div class="bg-white/3 border border-white/8 rounded-xl p-6 text-center hover:border-indigo-500/30 transition-all duration-200 card-glow">
          <div class="text-4xl font-bold gradient-text mb-1">{stat.value}</div>
          <div class="text-gray-500 text-sm font-medium">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Expertise + Recent Projects -->
    <div class="grid md:grid-cols-2 gap-6 mb-16">
      <div class="bg-white/3 border border-white/8 rounded-xl p-7 card-glow transition-all duration-200">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white">Core Expertise</h3>
        </div>
        <ul class="space-y-3">
          {[
            'Full-Stack Development',
            'System Architecture & Design',
            'Microservices & Cloud Solutions',
            'DevOps & CI/CD Pipelines',
            'Embedded Systems & Firmware',
          ].map(item => (
            <li class="flex items-center gap-3 text-gray-300">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white/3 border border-white/8 rounded-xl p-7 card-glow transition-all duration-200">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-lg bg-purple-500/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white">Recent Projects</h3>
        </div>
        <ul class="space-y-3">
          {[
            { icon: '🏆', text: 'Rewards Engine for Theme Parks' },
            { icon: '📊', text: 'Real-time Analytics Platform' },
            { icon: '🚀', text: 'Scalable Microservice Platform' },
            { icon: '🎬', text: 'OTT Media Processing Pipeline' },
            { icon: '🔌', text: 'Open Source npm Packages' },
          ].map(item => (
            <li class="flex items-center gap-3 text-gray-300">
              <span class="text-base">{item.icon}</span>
              {item.text}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Industries -->
    <div class="bg-white/3 border border-white/8 rounded-xl p-8 mb-16 card-glow transition-all duration-200">
      <h3 class="text-xl font-bold text-white mb-6">Industries I've Worked With</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {[
          { icon: '🎬', label: 'Audio / Visual', sub: 'Dolby' },
          { icon: '🎡', label: 'Themed Entertainment', sub: 'Universal, Disney' },
          { icon: '👔', label: 'Fashion', sub: 'Chanel' },
          { icon: '👥', label: 'Talent Acquisition', sub: 'Talent Logic' },
          { icon: '🔧', label: 'Manufacturing', sub: 'Ridge Tool' },
          { icon: '🌱', label: 'Non-Profits', sub: 'SeeTurtles' },
        ].map(item => (
          <div class="flex items-center gap-3 p-4 rounded-lg bg-white/3 border border-white/5 hover:border-indigo-500/30 transition-all duration-200">
            <span class="text-2xl">{item.icon}</span>
            <div>
              <div class="text-gray-200 font-medium text-sm">{item.label}</div>
              <div class="text-gray-500 text-xs">{item.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="relative overflow-hidden rounded-2xl cta-section p-10 text-center">
      <div class="relative z-10">
        <h2 class="text-3xl font-bold text-white mb-3">Let's Build Something Great</h2>
        <p class="text-gray-400 mb-8 max-w-lg mx-auto">
          Whether you need a technical co-founder, an architect, or a senior engineer — I'm ready for the next challenge.
        </p>
        <a
          href="mailto:dan@daniellmorris.com"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5"
        >
          Start a Conversation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero-section {
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(99, 102, 241, 0.15) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 50%, rgba(168, 85, 247, 0.08) 0%, transparent 60%),
      linear-gradient(180deg, #0f0f1a 0%, #030712 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cta-section {
    background:
      radial-gradient(ellipse 70% 80% at 50% 50%, rgba(99, 102, 241, 0.12) 0%, transparent 70%),
      linear-gradient(135deg, #0f0f1a 0%, #09091a 100%);
    border: 1px solid rgba(99, 102, 241, 0.15);
  }
</style>
