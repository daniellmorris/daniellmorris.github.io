---
import Layout from '../layouts/Layout.astro';

const expertise = [
  'Distributed systems architecture',
  'Event-driven backend platforms',
  'Cloud, hybrid, and on-premises delivery',
  'Reliability and production operations',
  'Applied AI and developer enablement',
  'Technical direction and engineering leadership'
];

const recentWork = [
  {
    text: 'Secure QR and authentication services',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />`
  },
  {
    text: 'Declarative release testing tools',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    text: 'High-scale engagement platforms',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    text: 'Hybrid deployment systems',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`
  },
  {
    text: 'AI-enabled applications and workflows',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.373 3.373 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`
  },
  {
    text: 'Open source platform tooling',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9l3 3-3 3m5 0h3M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" />`
  }
];

const industries = [
  { label: 'Audio / Visual', sub: 'Dolby', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />` },
  { label: 'Themed Entertainment', sub: 'Universal, Disney', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-3.314 0-6 1.79-6 4s2.686 4 6 4 6-1.79 6-4-2.686-4-6-4zm0 0V4m-5 5L4 6m13 3l3-3M7 15l-2 5m12-5l2 5" />` },
  { label: 'Fashion', sub: 'Chanel', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 4a3 3 0 006 0m-8 2l-4 4 3 3v7h12v-7l3-3-4-4-3 3h-4L7 6z" />` },
  { label: 'Talent Acquisition', sub: 'Talent Logic', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M15 7a3 3 0 11-6 0 3 3 0 016 0z" />` },
  { label: 'Manufacturing', sub: 'Ridge Tool', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.42 15.17l-5.66 5.66a2 2 0 01-2.83-2.83l5.66-5.66m2.83 2.83l5.66-5.66M14 6l4-4 4 4-4 4-4-4z" />` },
  { label: 'Non-Profits', sub: 'SeeTurtles', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21V9m0 0C8 9 5 7 5 3c4 0 7 2 7 6zm0 4c4 0 7-2 7-6-4 0-7 2-7 6z" />` }
];
---

<Layout title="Dan Morris - Software Engineer & Architect">
  <div>
    <section class="hero-section relative overflow-hidden rounded-2xl mb-10 sm:mb-14 reveal">
      <div class="relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] items-center gap-10 px-6 py-12 sm:px-10 sm:py-16 lg:px-16 lg:py-20">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-indigo-400/25 bg-indigo-400/10 text-indigo-200 text-xs font-semibold mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Available for select opportunities
          </div>
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold mb-5 tracking-tight leading-[0.96]">
            <span class="text-white">Dan</span>
            <span class="gradient-text"> Morris</span>
          </h1>
          <p class="text-xl sm:text-2xl text-gray-200 font-light mb-4">Software Engineer & Architect</p>
          <p class="text-gray-300 max-w-2xl mb-8 text-base sm:text-lg leading-relaxed">
            I design secure, scalable platforms, set technical direction, and guide engineers from architecture through production delivery. I also build open source tools that make production systems easier to operate.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/projects" class="inline-flex justify-center items-center gap-2 px-7 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:-translate-y-0.5">
              Explore Selected Work
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="mailto:dan@daniellmorris.com" class="inline-flex justify-center px-7 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-white/25 text-white font-semibold transition-all duration-200">
              Start a Conversation
            </a>
          </div>
        </div>

        <div class="hidden lg:block" aria-hidden="true">
          <div class="architecture-map">
            <div class="map-node map-node-main">
              <span>Platform</span>
              <strong>Architecture</strong>
            </div>
            <div class="map-node map-node-a">APIs</div>
            <div class="map-node map-node-b">Events</div>
            <div class="map-node map-node-c">Cloud</div>
            <div class="map-node map-node-d">Data</div>
            <div class="map-node map-node-e">AI</div>
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 420 320" fill="none">
              <path d="M210 160L85 70M210 160L335 70M210 160L70 235M210 160L350 235M210 160L210 280" stroke="url(#line)" stroke-width="1.5" />
              <defs>
                <linearGradient id="line" x1="70" y1="70" x2="350" y2="280">
                  <stop stop-color="#818CF8" stop-opacity=".8" />
                  <stop offset="1" stop-color="#C084FC" stop-opacity=".15" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden surface mb-10 sm:mb-14 reveal" style="--delay: 80ms">
      {[
        { value: '15+', label: 'Years building systems' },
        { value: '10+', label: 'Public OSS projects' },
        { value: '2', label: 'Patents held' },
        { value: '6', label: 'Industries served' }
      ].map(stat => (
        <div class="bg-gray-950/65 px-4 py-6 sm:p-7">
          <div class="text-3xl sm:text-4xl font-bold gradient-text mb-1">{stat.value}</div>
          <div class="text-gray-300 text-xs sm:text-sm font-medium">{stat.label}</div>
        </div>
      ))}
    </section>

    <section class="grid lg:grid-cols-2 gap-8 lg:gap-14 mb-12 sm:mb-16 reveal" style="--delay: 140ms">
      <div>
        <span class="section-kicker">Capabilities</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3 mb-6">Architecture grounded in delivery</h2>
        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-4">
          {expertise.map(item => (
            <div class="flex items-start gap-3 text-gray-200">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 flex-shrink-0 mt-2.5"></span>
              <span class="leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="surface rounded-2xl p-5 sm:p-7">
        <div class="flex items-center justify-between mb-5">
          <div>
            <span class="section-kicker">Recent Focus</span>
            <h2 class="text-xl font-bold text-white mt-2">Systems and tooling</h2>
          </div>
          <a href="/projects" class="text-sm font-semibold text-indigo-300 hover:text-indigo-200 transition-colors">View all</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-2">
          {recentWork.map(item => (
            <div class="flex items-center gap-3 rounded-xl px-3 py-3 hover:bg-white/5 transition-colors">
              <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-400/15 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
              </div>
              <span class="text-sm text-gray-200 leading-snug">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mb-12 sm:mb-16 reveal" style="--delay: 200ms">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <span class="section-kicker">Domain Experience</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3">Built across complex industries</h2>
        </div>
        <a href="/industries" class="text-sm font-semibold text-indigo-300 hover:text-indigo-200 transition-colors">Explore industries</a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3">
        {industries.map(item => (
          <div class="surface-subtle flex items-center gap-3 p-4 rounded-xl hover:border-indigo-400/30 transition-colors">
            <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <div class="min-w-0">
              <div class="text-gray-100 font-semibold text-sm leading-tight">{item.label}</div>
              <div class="text-gray-400 text-xs mt-1 truncate">{item.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section relative overflow-hidden rounded-2xl px-6 py-10 sm:p-12 text-center reveal" style="--delay: 260ms">
      <div class="relative z-10">
        <span class="section-kicker">Let&apos;s Talk</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-3 mb-3">Need senior technical direction?</h2>
        <p class="text-gray-300 mb-7 max-w-xl mx-auto leading-relaxed">
          I help teams turn ambiguous platform challenges into clear architecture, reliable delivery, and maintainable systems.
        </p>
        <a href="mailto:dan@daniellmorris.com" class="inline-flex items-center gap-2 px-7 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:-translate-y-0.5">
          Start a Conversation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-section {
    background:
      radial-gradient(ellipse 70% 80% at 85% 20%, rgba(99, 102, 241, 0.18) 0%, transparent 62%),
      radial-gradient(ellipse 55% 65% at 20% 0%, rgba(168, 85, 247, 0.1) 0%, transparent 65%),
      linear-gradient(135deg, rgba(15, 15, 30, 0.96), rgba(3, 7, 18, 0.98));
    border: 1px solid rgba(148, 163, 184, 0.14);
  }

  .architecture-map {
    position: relative;
    height: 320px;
    max-width: 420px;
    margin-left: auto;
  }

  .map-node {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    height: 40px;
    padding: 0 1rem;
    border-radius: 0.75rem;
    color: #c7d2fe;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(129, 140, 248, 0.26);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.25);
  }

  .map-node-main {
    left: 50%;
    top: 50%;
    width: 132px;
    height: 84px;
    transform: translate(-50%, -50%);
    flex-direction: column;
    color: #e0e7ff;
    background: linear-gradient(145deg, rgba(79, 70, 229, 0.35), rgba(15, 23, 42, 0.95));
  }

  .map-node-main span { font-size: 0.65rem; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.12em; }
  .map-node-main strong { font-size: 0.9rem; margin-top: 0.25rem; }
  .map-node-a { left: 10px; top: 48px; }
  .map-node-b { right: 10px; top: 48px; }
  .map-node-c { left: 0; bottom: 48px; }
  .map-node-d { right: 0; bottom: 48px; }
  .map-node-e { left: 50%; bottom: 0; transform: translateX(-50%); }

  .cta-section {
    background:
      radial-gradient(ellipse 70% 100% at 50% 100%, rgba(99, 102, 241, 0.18) 0%, transparent 70%),
      linear-gradient(135deg, rgba(15, 15, 30, 0.96), rgba(9, 9, 26, 0.96));
    border: 1px solid rgba(99, 102, 241, 0.2);
  }
</style>
