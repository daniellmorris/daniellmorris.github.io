---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    year: 'Nov 2023 – Present',
    role: 'Lead System Architect',
    company: 'Gigantic Playground',
    location: 'Remote',
    highlights: [
      'Spearheaded system architecture and development initiatives for next-generation platforms',
      'Architected scalable solutions focusing on performance optimization and system reliability'
    ],
    technologies: ['System Architecture', 'Performance Optimization', 'Scalable Systems Design']
  },
  {
    year: 'Jan 2020 – Oct 2023',
    role: 'Lead Engineer',
    company: 'Valtech',
    highlights: [
      'Orchestrated development strategies for Universal Studios Theme Parks, Walt Disney Imagineering, and Dolby',
      'Pioneered and maintained several widely-adopted open source npm packages',
      'Designed enterprise-scale solutions using Node.js, Express.js, MongoDB, and Kubernetes',
      'Architected cloud infrastructure leveraging AWS Lambda, EC2, CloudFormation, and containerization'
    ],
    technologies: ['Node.js', 'Express.js', 'MongoDB', 'Kubernetes', 'AWS', 'RabbitMQ', 'Terraform', 'Docker']
  },
  {
    year: 'Jul 2015 – Dec 2019',
    role: 'Software Developer',
    company: 'Independent Contractor',
    highlights: [
      'Engineered high-performance web scraping system achieving 1M+ records per hour',
      'Developed CRM and marketing automation platform for improved customer engagement',
      'Implemented cloud infrastructure utilizing AWS auto-scaling, EC2, RDS, and SQS',
      'Designed scalable solutions using Node.js, PostgreSQL, Meteor.js, and MongoDB'
    ],
    technologies: ['Node.js', 'PostgreSQL', 'MongoDB', 'Meteor.js', 'AWS']
  },
  {
    year: 'Oct 2011 – Mar 2015',
    role: 'Software Engineer',
    company: 'Ciholas Inc.',
    location: 'Evansville, IN',
    highlights: [
      'Pioneered critical embedded software solutions for mining safety systems',
      'Engineered high-precision sports tracking firmware for performance analytics',
      'Developed advanced high-frequency location tracking systems',
      'Secured two patents: US #9709663 (radio signal location) and US #10904917 (wireless transmission scheduling)'
    ],
    technologies: ['Embedded C', 'Firmware', 'RF Systems']
  },
  {
    year: 'Jan 2010 – Aug 2010',
    role: 'Web Developer Co-op',
    company: 'Ridge Tool Company',
    location: 'Elyria, OH',
    highlights: [
      'Enhanced legacy systems across ASP, ASP.NET, and Java platforms',
      'Engineered WCF Server infrastructure for email processing using C#',
      'Developed web CRM system using Apache Struts framework',
      'Created REST web services architecture and Android media upload application'
    ],
    technologies: ['C#', 'Java', 'ASP.NET', 'WCF', 'Android']
  }
];

const expertise = [
  {
    area: 'Backend Development',
    description: 'Scalable architectures, API design, and microservices using Node.js, Python, and Java.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />`
  },
  {
    area: 'Frontend Development',
    description: 'Responsive and intuitive user interfaces using React, Vue.js, and modern JavaScript.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`
  },
  {
    area: 'System Architecture',
    description: 'Designing robust, scalable systems with focus on performance, security, and maintainability.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    area: 'DevOps & Cloud',
    description: 'CI/CD pipelines and cloud infrastructure using AWS, Docker, and Kubernetes.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`
  }
];
---

<Layout title="About - Dan Morris">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="relative overflow-hidden rounded-2xl p-8 md:p-12 mb-12 about-hero">
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-5 gradient-text">About Me</h1>
        <p class="text-lg text-gray-300 leading-relaxed max-w-2xl">
          Hi, I'm Dan Morris — a seasoned Lead System Architect with a passion for turning complex challenges into
          elegant, scalable solutions. With 15+ years in the field, I've mastered the art of building robust
          systems that seamlessly integrate sophisticated backend architectures with intuitive frontend experiences.
        </p>
      </div>
    </div>

    <!-- Philosophy cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="bg-white/3 border border-white/8 rounded-xl p-6 card-glow transition-all duration-200">
        <h2 class="text-lg font-semibold mb-3 gradient-text-blue">Professional Journey</h2>
        <p class="text-gray-400 leading-relaxed text-sm">
          Throughout my career, I've collaborated with organizations from innovative startups to industry-leading
          enterprises. My expertise spans high-performance media processing, immersive theme park experiences,
          embedded safety systems, and sophisticated distributed architectures.
        </p>
      </div>

      <div class="bg-white/3 border border-white/8 rounded-xl p-6 card-glow transition-all duration-200">
        <h2 class="text-lg font-semibold mb-3 gradient-text">Philosophy</h2>
        <p class="text-gray-400 leading-relaxed text-sm">
          Technology should empower people. My approach blends technical innovation with pragmatic problem-solving —
          delivering solutions that are not only cutting-edge but sustainable and impactful. I strive to create
          systems that make a meaningful difference.
        </p>
      </div>
    </div>

    <!-- Expertise -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-white">Areas of Expertise</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {expertise.map(item => (
          <div class="bg-white/3 border border-white/8 rounded-xl p-5 card-glow transition-all duration-200 flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-indigo-500/15 border border-indigo-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-white mb-1">{item.area}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience timeline -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-white">Professional Experience</h2>
      <div class="relative">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-indigo-500/40 via-indigo-500/20 to-transparent ml-4 hidden md:block"></div>
        <div class="space-y-4">
          {experience.map((item, i) => (
            <div class="md:pl-12 relative">
              <div class="hidden md:block absolute left-0 w-3 h-3 rounded-full bg-indigo-500 border-2 border-gray-950 top-6 -translate-x-1"></div>
              <div class="bg-white/3 border border-white/8 rounded-xl p-6 card-glow transition-all duration-200">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-2">
                  <div>
                    <h3 class="text-base font-semibold gradient-text-blue">{item.role}</h3>
                    <p class="text-purple-400/90 font-medium text-sm">{item.company}</p>
                    {item.location && <p class="text-gray-500 text-xs mt-0.5">{item.location}</p>}
                  </div>
                  <span class="text-xs font-medium px-3 py-1.5 rounded-lg bg-white/5 border border-white/8 text-gray-400 whitespace-nowrap">{item.year}</span>
                </div>
                <ul class="space-y-1.5 mb-4">
                  {item.highlights.map(h => (
                    <li class="flex items-start gap-2 text-gray-400 text-sm">
                      <span class="text-indigo-500 mt-1.5 flex-shrink-0">›</span>
                      {h}
                    </li>
                  ))}
                </ul>
                {item.technologies && (
                  <div class="flex flex-wrap gap-1.5">
                    {item.technologies.map(tech => (
                      <span class="tag text-xs">{tech}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <div class="relative overflow-hidden rounded-2xl p-8 text-center cta-about">
      <div class="relative z-10">
        <h2 class="text-2xl font-bold text-white mb-3">Let's Work Together</h2>
        <p class="text-gray-400 text-sm mb-6 max-w-md mx-auto">
          Whether you need architectural guidance, technical expertise, or a strategic technology partner — I'd love to help.
        </p>
        <a
          href="mailto:dan@daniellmorris.com"
          class="inline-flex items-center gap-2 px-7 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 shadow-lg shadow-indigo-500/20 hover:-translate-y-0.5"
        >
          Get in Touch
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .about-hero {
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 70%),
      linear-gradient(180deg, #0f0f1a 0%, #030712 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cta-about {
    background:
      radial-gradient(ellipse 60% 80% at 50% 50%, rgba(99, 102, 241, 0.1) 0%, transparent 70%),
      #080812;
    border: 1px solid rgba(99, 102, 241, 0.15);
  }
</style>
