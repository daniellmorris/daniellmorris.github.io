---
import Layout from '../layouts/Layout.astro';

const industries = [
  {
    name: 'Audio / Visual',
    clients: ['Dolby'],
    icon: '🎬',
    description: 'Developed media processing pipelines and streaming solutions for high-quality audio/visual content delivery.',
    color: 'indigo'
  },
  {
    name: 'Themed Entertainment',
    clients: ['Universal', 'Disney'],
    icon: '🎡',
    description: 'Created interactive experiences and backend systems for theme park attractions and guest engagement platforms.',
    color: 'purple'
  },
  {
    name: 'Fashion',
    clients: ['Chanel'],
    icon: '👔',
    description: 'Developed digital solutions for luxury fashion brands, including e-commerce and inventory management systems.',
    color: 'pink'
  },
  {
    name: 'Talent Acquisition',
    clients: ['Talent Logic'],
    icon: '👥',
    description: 'Built custom CRM solutions and performance tracking systems for talent management and recruitment operations.',
    color: 'sky'
  },
  {
    name: 'Hardware Manufacturing',
    clients: ['Ridge Tool'],
    icon: '🔧',
    description: 'Implemented inventory and production management systems for large-scale manufacturing operations.',
    color: 'orange'
  },
  {
    name: 'Non-Profits',
    clients: ['SeeTurtles'],
    icon: '🌱',
    description: 'Developed websites and donation platforms for environmental conservation organizations.',
    color: 'emerald'
  }
];

const colorMap: Record<string, { bg: string; border: string; badge: string; badgeBorder: string; badgeText: string }> = {
  indigo:  { bg: 'rgba(99,102,241,0.06)',  border: 'rgba(99,102,241,0.2)',  badge: 'rgba(99,102,241,0.12)',  badgeBorder: 'rgba(99,102,241,0.25)', badgeText: '#a5b4fc' },
  purple:  { bg: 'rgba(168,85,247,0.06)',  border: 'rgba(168,85,247,0.2)',  badge: 'rgba(168,85,247,0.12)',  badgeBorder: 'rgba(168,85,247,0.25)', badgeText: '#d8b4fe' },
  pink:    { bg: 'rgba(236,72,153,0.06)',  border: 'rgba(236,72,153,0.2)',  badge: 'rgba(236,72,153,0.12)',  badgeBorder: 'rgba(236,72,153,0.25)', badgeText: '#f9a8d4' },
  sky:     { bg: 'rgba(14,165,233,0.06)',  border: 'rgba(14,165,233,0.2)',  badge: 'rgba(14,165,233,0.12)',  badgeBorder: 'rgba(14,165,233,0.25)', badgeText: '#7dd3fc' },
  orange:  { bg: 'rgba(249,115,22,0.06)',  border: 'rgba(249,115,22,0.2)',  badge: 'rgba(249,115,22,0.12)',  badgeBorder: 'rgba(249,115,22,0.25)', badgeText: '#fdba74' },
  emerald: { bg: 'rgba(16,185,129,0.06)',  border: 'rgba(16,185,129,0.2)',  badge: 'rgba(16,185,129,0.12)',  badgeBorder: 'rgba(16,185,129,0.25)', badgeText: '#6ee7b7' },
};
---

<Layout title="Industries - Dan Morris">
  <div class="max-w-4xl mx-auto">
    <div class="relative overflow-hidden rounded-2xl p-8 md:p-12 mb-12 industries-hero">
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 gradient-text">Industry Experience</h1>
        <p class="text-gray-400 text-lg max-w-xl">
          Delivering specialized solutions across diverse sectors, combining technical expertise with deep domain knowledge.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {industries.map(industry => {
        const c = colorMap[industry.color];
        return (
          <div
            class="rounded-xl p-6 border card-glow transition-all duration-200"
            style={`background: ${c.bg}; border-color: ${c.border};`}
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">{industry.icon}</span>
              <h2 class="text-lg font-semibold text-white">{industry.name}</h2>
            </div>
            <p class="text-gray-400 text-sm leading-relaxed mb-4">{industry.description}</p>
            <div class="flex flex-wrap gap-2">
              {industry.clients.map(client => (
                <span
                  class="px-3 py-1 rounded-full text-xs font-medium border"
                  style={`background: ${c.badge}; border-color: ${c.badgeBorder}; color: ${c.badgeText};`}
                >
                  {client}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .industries-hero {
    background:
      radial-gradient(ellipse 70% 60% at 30% 50%, rgba(99, 102, 241, 0.1) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 80% 30%, rgba(168, 85, 247, 0.06) 0%, transparent 60%),
      linear-gradient(180deg, #0f0f1a 0%, #030712 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>
